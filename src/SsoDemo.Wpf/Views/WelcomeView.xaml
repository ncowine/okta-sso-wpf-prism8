<UserControl x:Class="SsoDemo.Wpf.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Width="460" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="You're signed in" Style="{StaticResource Subtle}" />
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Heading}" Margin="0,2,0,16" />

                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Email / login id" Style="{StaticResource Subtle}" Width="120" />
                    <TextBlock Text="{Binding Email}" Style="{StaticResource Subtle}"
                               Foreground="{StaticResource Brush.Text}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,18">
                    <TextBlock Text="AD employee id" Style="{StaticResource Subtle}" Width="120" />
                    <TextBlock Text="{Binding EmployeeId}" Style="{StaticResource Subtle}"
                               Foreground="{StaticResource Brush.Text}" />
                </StackPanel>

                <Button Content="Exit"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left"
                        Command="{Binding ExitCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Width="460">
            <StackPanel>
                <TextBlock Text="Token-authenticated API calls" Style="{StaticResource Heading}" FontSize="14" />
                <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,12">
                    <Run Text="DemoApi at " /><Run Text="{Binding ApiBaseUrl, Mode=OneWay}" FontFamily="Consolas" />
                </TextBlock>

                <WrapPanel>
                    <Button Content="GET /api/profile" Margin="0,0,8,8"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CallProfileCommand}" />
                    <Button Content="GET /api/orders" Margin="0,0,8,8"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CallOrdersCommand}" />
                    <ProgressBar IsIndeterminate="True" Width="60" Height="3" Margin="4,0,0,8"
                                 VerticalAlignment="Center" BorderThickness="0"
                                 Visibility="{Binding IsCallingApi, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>

                <TextBlock Text="Third-party API (DemoApiB) — two ways in"
                           Style="{StaticResource Subtle}" Foreground="{StaticResource Brush.Text}"
                           Margin="0,8,0,4" />
                <WrapPanel>
                    <Button Content="GET /b/resource (direct)" Margin="0,0,8,8"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CallApiBDirectCommand}" />
                    <Button Content="GET /api/partner (via token exchange)" Margin="0,0,8,8"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CallApiBViaExchangeCommand}" />
                </WrapPanel>

                <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0"
                           Foreground="{StaticResource Brush.Danger}"
                           Text="{Binding ApiError}"
                           Visibility="{Binding HasApiError, Converter={StaticResource BoolToVisibility}}" />

                <Border Margin="0,10,0,0" Background="#0D1117" CornerRadius="6" Padding="10"
                        MaxHeight="220">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding ApiResponse, Mode=OneWay}"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Foreground="#E6EDF3" FontFamily="Consolas" FontSize="12"
                                 TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
