<UserControl x:Class="SsoDemo.Wpf.Views.AccessDeniedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid>
        <Border Style="{StaticResource Card}" Width="420"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Access denied" Style="{StaticResource Heading}"
                           Foreground="{StaticResource Brush.Danger}" />
                <TextBlock Text="{Binding Headline}" Style="{StaticResource Subtle}"
                           Foreground="{StaticResource Brush.Text}" Margin="0,8,0,0" />

                <TextBlock Text="{Binding ErrorDetail}" Style="{StaticResource Subtle}" Margin="0,12,0,18" />

                <Button Content="Exit"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left"
                        Command="{Binding ExitCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
