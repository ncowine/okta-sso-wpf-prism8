<Window x:Class="SsoDemo.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}"
        Height="560" Width="860"
        MinHeight="440" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource Brush.Background}" CornerRadius="12" Padding="12,5">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Subtle}" />
                </Border>
            </Grid>
        </Border>

        <ContentControl prism:RegionManager.RegionName="ContentRegion"
                        Margin="0" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </DockPanel>
</Window>
