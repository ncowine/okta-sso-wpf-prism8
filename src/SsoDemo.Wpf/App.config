<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- ===== Okta SSO configuration =====
         This file is currently pointed at the bundled DUMMY IdP (tools/DummyIdp) so the app
         runs with no real tenant.
           1. start the IdP:   dotnet run  (project) tools/DummyIdp
           2. run the app:     dotnet run  (project) src/SsoDemo.Wpf

         For a real Okta tenant, set:
           Okta:OktaDomain        = https://YOUR-ORG.okta.com
           Okta:ClientId          = your native app client id
           Okta:AllowInsecureHttp = false
    -->

    <!-- Okta org base URL (dummy IdP: http://localhost:5005). -->
    <add key="Okta:OktaDomain" value="http://localhost:5005" />

    <!-- Custom authorization server id. 'default' => issuer {OktaDomain}/oauth2/default -->
    <add key="Okta:AuthorizationServerId" value="default" />

    <!-- OIDC client (application) id of the native/desktop app registration. -->
    <add key="Okta:ClientId" value="sso-demo-wpf" />

    <!-- Expected audience (aud) of the access token. -->
    <add key="Okta:Audience" value="api://default" />

    <!-- Redirect + post-logout URIs. Must match the IdP app config exactly. -->
    <add key="Okta:RedirectUri" value="app://auth/callback" />
    <add key="Okta:PostLogoutRedirectUri" value="app://auth/callback" />

    <!-- Scopes. 'offline_access' is required for silent refresh on next launch. -->
    <add key="Okta:Scope" value="openid profile email offline_access" />

    <!-- The scheme part of the redirect URI; registered with Windows on startup. -->
    <add key="Okta:CustomUriScheme" value="app" />

    <!-- Token validation tuning. -->
    <add key="Okta:ClockSkewSeconds" value="60" />
    <add key="Okta:ValidateTokenClientId" value="true" />

    <!-- DEV ONLY. 'true' allows an http authority so the app can run against the bundled
         dummy IdP (tools/DummyIdp) on localhost. Signature/issuer/audience are still validated.
         Set 'false' for real Okta. See scripts/run-demo.ps1 and docs/dummy-idp.md. -->
    <add key="Okta:AllowInsecureHttp" value="true" />

    <!-- Token-protected demo APIs (tools/DemoApi and the third-party tools/DemoApiB). -->
    <add key="Api:BaseUrl" value="http://localhost:5006" />
    <add key="Api:BaseUrlB" value="http://localhost:5007" />

    <!-- Access-token claim names for this tenant's customized token.
         sub        gives the user name (value shaped like first.lastName)
         SAMAccount gives the email / login id
         empID      gives the AD employee id -->
    <add key="Okta:NameSourceClaim" value="sub" />
    <add key="Okta:EmailSourceClaim" value="SAMAccount" />
    <add key="Okta:EmployeeIdSourceClaim" value="empID" />

    <!-- Optional: also tee the Debug/Trace log to this file (useful when not running under a
         debugger). Leave empty to disable. -->
    <add key="Diagnostics:TraceFile" value="" />
  </appSettings>
</configuration>
