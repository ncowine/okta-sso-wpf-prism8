<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows for modern WPF host apps; net472 so any .NET Framework WPF app can
         reference this library too (it owns the WPF single-instance/custom-scheme ceremony). -->
    <TargetFrameworks>net8.0-windows;net472</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>Common.Authentication.Okta</RootNamespace>
    <AssemblyName>Common.Authentication.Okta</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standard .NET OIDC client: discovery, Authorization Code + PKCE, state/nonce,
         ID-token validation, token endpoint calls and refresh. No custom protocol code. -->
    <PackageReference Include="IdentityModel.OidcClient" Version="6.0.0" />

    <!-- Access-token (JWT) validation against Okta: JWKS signature, issuer, audience, lifetime. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.0.2" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.0.2" />

    <!-- Backs OidcClient's required ILoggerFactory with a Debug.WriteLine sink by default,
         so a host app doesn't have to wire up Microsoft.Extensions.Logging itself. -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />

    <!-- DPAPI-backed secure storage for the refresh/ID tokens (CurrentUser scope). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />

    <!-- IContainerRegistry (Prism.Ioc namespace) so this library can expose a single
         AddOktaAuthentication(...) extension method for every Prism WPF host app to register
         against, instead of each host hand-rolling the same five registrations. -->
    <PackageReference Include="Prism.Core" Version="8.1.97" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <!-- System.Text.Json ships in the net8.0 shared framework but is a separate package on .NET Framework. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />

    <!-- Reference assemblies for net472 so this project builds headlessly without a full VS/.NET
         Framework targeting-pack install (e.g. on a CI agent that only has the .NET SDK). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />

    <!-- ConfigurationManager (used by OktaOptionsFactory) is in-box on .NET Framework but, unlike
         the classic-csproj default, an SDK-style net472 project doesn't reference it implicitly. -->
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <!-- ConfigurationManager (used by OktaOptionsFactory) ships in-box on net472 but is a
         separate package on .NET; the WPF shared framework doesn't pull it in for a library. -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>

</Project>
